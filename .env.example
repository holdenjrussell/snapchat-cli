# ============================================================
# snapchat-cli — consolidated environment template
# Copy to ~/.config/snapchat-ads-cli/.env  (chmod 0600)
# Everything in this stack reads that file (CLI, reports,
# optimizer, warehouse sync) unless the var is already exported.
# ============================================================

# --- Snap Marketing API OAuth app (Snap Business Manager -> Apps) ---
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
# Registered redirect URI; localhost is fine for CLI use
SNAPCHAT_REDIRECT_URI=https://localhost:8080/callback

# --- Filled in by `snapchat-ads auth login` (do not set manually) ---
SNAPCHAT_ACCESS_TOKEN=
SNAPCHAT_REFRESH_TOKEN=

# --- Account scope (from `snapchat-ads org list` / `org list-accounts`) ---
SNAPCHAT_ORGANIZATION_ID=
SNAPCHAT_AD_ACCOUNT_ID=
SNAPCHAT_PIXEL_ID=

# --- Account key in ~/.config/snapchat-ads-cli/accounts.toml ---
SNAPCHAT_ADS_ACCOUNT=default

# --- Branding (used in Slack reports) ---
BRAND_NAME=My Brand

# --- Slack reporting ---
# Bot token with chat:write scope, invited to the target channel
SLACK_BOT_TOKEN=
# Channel ID for the hourly heartbeat + optimizer reports (e.g. C0XXXXXXXXX)
SNAPCHAT_HOURLY_SLACK_CHANNEL=

# --- Data warehouse (any Postgres: Neon, Supabase, RDS, local) ---
DATABASE_URL=

# --- Optional overrides ---
# Path to optimizer config (default: <repo>/config/optimizer.json)
#SNAP_OPTIMIZER_CONFIG=
# Path to the warehouse query helper (default: <repo>/warehouse/query.py)
#SNAP_WAREHOUSE_QUERY=
# Where install-cron-jobs writes agent-scheduler job definitions
#SNAP_CRON_JOBS_PATH=
# Extra .env file for the CLI to source
#SNAPCHAT_ADS_ENV_FILE=
