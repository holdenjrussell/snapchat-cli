# Snapchat Marketing API credentials -- per-profile copy
# Source of truth for client secrets is Snap Business Manager -> Apps.

SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
# HTTPS redirect URI registered on the Snap app.
# `snapchat-ads auth callback-url` provisions one via Tailscale Funnel.
SNAPCHAT_REDIRECT_URI=

# Tokens (filled in by `snapchat-ads auth login`; leave blank initially)
SNAPCHAT_ACCESS_TOKEN=
SNAPCHAT_REFRESH_TOKEN=

# Account scope (fill in once `org list` returns the IDs)
SNAPCHAT_ORGANIZATION_ID=
SNAPCHAT_AD_ACCOUNT_ID=
SNAPCHAT_PIXEL_ID=
