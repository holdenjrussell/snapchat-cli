# Snapchat Marketing API credentials
# Register a Snap Business app at https://business.snapchat.com to obtain these.

# OAuth client (from Snap Business Manager -> Apps)
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=

# Redirect URI registered with the Snap app. Localhost is fine for CLI use.
SNAPCHAT_REDIRECT_URI=https://localhost:8080/callback

# Tokens (filled in by `snapchat-ads auth login` -- you do not need to set these manually)
SNAPCHAT_ACCESS_TOKEN=
SNAPCHAT_REFRESH_TOKEN=

# Account scope (filled in once `snapchat-ads org list` returns your IDs)
SNAPCHAT_ORGANIZATION_ID=
SNAPCHAT_AD_ACCOUNT_ID=
SNAPCHAT_PIXEL_ID=
